# Copy to `.env` and fill in. `docker compose` reads it.

# ── Secrets (REQUIRED in production) ──────────────────────────────────────────
# Shared JWT secret. The portal AND the spawned elog backend both use it, so a
# portal login token is trusted on entry (SSO). Set ELOG_SECRET_KEY and the
# portal picks it up automatically (config.SECRET_KEY falls back to it).
# Generate one: `python3 -c "import secrets; print(secrets.token_urlsafe(48))"`
ELOG_SECRET_KEY=CHANGE-ME-to-a-long-random-string

# Token a service presents to self-register via POST /api/handshake. Rotate it.
PORTAL_REGISTER_TOKEN=CHANGE-ME-too

# ── Email verification ────────────────────────────────────────────────────────
# Verification is ON by default (new signups must verify before login, and yearly
# after). In production, configure Resend and keep DEV_ECHO off. Set
# EMAIL_VERIFY_REQUIRED=0 to disable entirely.
EMAIL_VERIFY_REQUIRED=1
EMAIL_VERIFY_DEV_ECHO=1
RESEND_API_KEY=
RESEND_FROM_EMAIL=portal@stellarpiece.com
RESEND_REPLY_TO=

# ── Data (per-server, lives OUTSIDE the container) ────────────────────────────
# Host folder bind-mounted at /app/data — the ONLY state (portal.db + every
# service's data). Each server keeps its own; back it up / move it independently
# of the image. Default ./portal-data (next to docker-compose.yml). Point it at a
# dedicated/large disk in production, e.g. /srv/lilak/data
PORTAL_DATA_DIR=./portal-data

# ── Networking ────────────────────────────────────────────────────────────────
PORTAL_PORT=8025
# Keep the portal reachable only from this host; Cloudflare Tunnel is the public front door.
PORTAL_BIND=127.0.0.1
# Public URL the portal is reached at (used in handshake/entry links). Set this to
# the real host in production, e.g. https://portal.example.org
PORTAL_BASE_URL=http://localhost:8025

# ── sci-runner (nptoy's ROOT+Geant4+nptool container; opt-in `--profile sci`) ──
# Optional shared secret between the portal and the internal sci-runner API. Leave
# blank to disable the check (the runner is never published outside the compose net).
SCI_TOKEN=

# ── resource limits (OOM protection) ──────────────────────────────────────────
# Max heavy npsimulation processes running at once (interactive sessions + batch
# jobs combined). Sized to host RAM; raise cautiously.
NPTOY_MAX_CONCURRENT_SIMS=3
# Per-container memory ceilings. mem_limit = RAM cap; memswap_limit = RAM+swap
# total. Keep the sum comfortably below host RAM (leave room for the OS/desktop).
# Defaults assume a ~14 GB host: portal 3g, sci-runner 7g.
PORTAL_MEM_LIMIT=3g
PORTAL_MEMSWAP_LIMIT=4g
SCI_MEM_LIMIT=7g
SCI_MEMSWAP_LIMIT=9g
