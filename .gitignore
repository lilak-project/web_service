# ── secrets & runtime state — server-only, NEVER in git ──
.env
/data/
/portal-data/

# per-service runtime markers (written at start)
**/.port
**/.pid

# deps & build output — rebuilt inside the Docker image
**/node_modules/
**/.venv/
**/dist/
**/__pycache__/
**/*.pyc

# misc
.DS_Store
*.log
/_stack/
**/.dev-server.pid
