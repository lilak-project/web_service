# ── secrets & runtime state — server-only, NEVER in git ──
.env
/data/
/portal-data/

# per-service runtime markers (written at start)
**/.port
**/.pid

# deps & build output — rebuilt inside the Docker image
**/node_modules/
**/.venv/
**/dist/
**/__pycache__/
**/*.pyc

# build-time git SHA snapshot (regenerated by build.sh on every build)
/service_manager/git-versions.json

# misc
.DS_Store
*.log
/_stack/
**/.dev-server.pid

# Services moved in beside the stack (2026-09-06). Each is its own git repo, so
# git would otherwise record them as embedded repositories — a gitlink with no
# URL behind it, which clones as an empty directory. Ignored until they have
# remotes and can become real submodules; the store finds them by path either way.
/actuator_control/
/actuator_monitoring/
/compass_monitoring/
/compass_remote
/ganil_control
/dummy_daq/
/ganil_daq_monitoring/
/hv_control_monitoring/
/minicom_monitoring/
/mte_control/
/mte_monitoring/
/vacuum_monitoring/
