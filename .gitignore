# ── secrets & runtime state — server-only, NEVER in git ──
.env
/data/
/portal-data/

# per-service runtime markers (written at start)
**/.port
**/.pid

# deps & build output — rebuilt inside the Docker image
**/node_modules/
**/.venv/
**/dist/
**/__pycache__/
**/*.pyc

# build-time git SHA snapshot (regenerated by build.sh on every build)
/service_manager/git-versions.json

# misc
.DS_Store
*.log
/_stack/
**/.dev-server.pid

# The services that moved in beside the stack (2026-09-06) are submodules now
# that they have remotes under github.com/lilak-project -- see .gitmodules. They
# were ignored here until then, because git records a repo with no remote as a
# gitlink with no URL behind it, which clones as an empty directory.
#
# compass_remote and ganil_control live one level up, in service/, and are
# symlinked in. A symlink is not a submodule, so those two stay ignored.
/compass_remote
/ganil_control
