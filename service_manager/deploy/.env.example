# Copy to deploy/.env and fill in. These are RUNTIME config/secrets — they are
# NOT baked into the image.

# ── Security (set real values in production) ─────────────────────────────────
# Shared JWT secret — MUST be the same value the elog backend trusts (SSO).
PORTAL_SECRET_KEY=change-me-to-a-long-random-string
# Handshake self-registration token (services paste this to register themselves).
PORTAL_REGISTER_TOKEN=change-me-too

# ── Email verification (account activation) ──────────────────────────────────
EMAIL_VERIFY_REQUIRED=1
# 1 = dev stub (return the link); 0 = actually send (wire up Firebase below).
EMAIL_VERIFY_DEV_ECHO=1

# ── Firebase (only when EMAIL_VERIFY_DEV_ECHO=0) ──────────────────────────────
# Provide credentials at runtime; do NOT bake them into the image.
# (The send hook in app/routers/auth.py register() must be implemented to use these.)
# FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase.json   # mount the key as a secret

# ── sci-runner (ROOT + Geant4 + nptool container; see sci-runner/DEPLOY.md) ──
# Shared secret between the portal and the internal sci-runner. Leave blank to
# disable the check (fine on an internal-only network); set a random value to
# require it on every runner call.
SCI_TOKEN=
# Hard per-job wall-clock cap on the runner (seconds).
SCI_JOB_TIMEOUT=1800

# ── Misc ─────────────────────────────────────────────────────────────────────
# PORTAL_PORT=8025
# PORTAL_BASE_URL=https://portal.example.com
