{
  "kind": "monitor",
  "mode": "managed",
  "start": {
    "cmd": "/app/scope/target/release/scope --host 127.0.0.1 --port {port}",
    "cwd": "/app/scope",
    "env": {
      "SCOPE_BROWSE_PATH": "{project_data}"
    }
  },
  "health": "/api/health",
  "entry": "/",
  "url": null,
  "token": null,
  "identity": {
    "accepts_portal_token": false,
    "link_by": "email"
  },
  "capabilities": {
    "multi_project": true,
    "import_export": false,
    "project_files": [
      {
        "file": "browse-path",
        "ko": "Browse 폴더 (한 줄에 하나, 뷰어가 읽을 수 있는 범위)",
        "en": "Browse folders (one per line: what the viewer may read)",
        "placeholder": "/data/acquisition/run\n/home/shared/scope"
      }
    ]
  },
  "icon": "activity",
  "color": "#0c8599",
  "label": "Scope",
  "live": false,
  "look": "neon"
}
