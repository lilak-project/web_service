{
  "kind": "control",
  "mode": "managed",
  "start": {
    "cmd": "/usr/bin/python3 -m uvicorn app.main:app --host 127.0.0.1 --port {port}",
    "cwd": "/app/actuator_control/backend",
    "env": {}
  },
  "health": "/api/health",
  "entry": "/",
  "url": null,
  "token": null,
  "identity": {
    "accepts_portal_token": false,
    "link_by": "email"
  },
  "capabilities": {
    "multi_project": false,
    "import_export": true
  },
  "icon": "arrows-left-right",
  "color": "#1971c2",
  "label": "Actuator Control",
  "order": 1,
  "autostart": true
}
