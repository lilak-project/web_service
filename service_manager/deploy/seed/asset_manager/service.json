{
  "kind": "asset",
  "mode": "managed",
  "start": {
    "cmd": "uvicorn main:app",
    "cwd": "/app/asset_manager/backend",
    "env": {
      "ASSET_DATA_DIR": "{project_data}",
      "ASSET_DIST_DIR": "/app/asset_manager/dist"
    }
  },
  "health": "/",
  "entry": "/",
  "identity": {
    "accepts_portal_token": true,
    "link_by": "email"
  },
  "capabilities": {
    "multi_project": true,
    "import_export": true
  },
  "icon": null,
  "color": null
}
