{
  "kind": "rack",
  "mode": "managed",
  "start": {
    "cmd": "sh /app/project_manager/portal-serve.sh {port}",
    "cwd": "/app/project_manager",
    "env": {}
  },
  "health": "/",
  "entry": "/",
  "url": null,
  "token": null,
  "identity": {
    "accepts_portal_token": true,
    "link_by": "email"
  },
  "capabilities": {
    "multi_project": true,
    "import_export": true
  },
  "icon": "folder",
  "color": "#0f766e",
  "label": "프로젝트",
  "open": "panel",
  "entry_project": "projects"
}
