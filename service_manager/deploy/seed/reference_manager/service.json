{
  "kind": "reference",
  "mode": "managed",
  "start": {
    "cmd": "sh /app/reference_manager/portal-serve.sh {port}",
    "cwd": "/app/reference_manager",
    "env": {}
  },
  "health": "/",
  "entry": "/",
  "identity": {
    "accepts_portal_token": true,
    "link_by": "email"
  },
  "capabilities": {
    "multi_project": true,
    "import_export": true
  },
  "label": "References",
  "icon": "books",
  "color": "#7c5295",
  "open": "panel"
}
