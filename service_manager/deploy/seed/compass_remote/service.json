{
  "kind": "control",
  "mode": "managed",
  "start": {
    "cmd": "uvicorn app.main:app",
    "cwd": "/app/compass_remote/backend",
    "env": {}
  },
  "health": "/api/health",
  "entry": "/",
  "url": null,
  "token": null,
  "identity": {
    "accepts_portal_token": true,
    "link_by": "email"
  },
  "capabilities": {
    "multi_project": false,
    "import_export": false
  },
  "icon": "compass",
  "color": "#e8590c",
  "label": "COMPASS Remote Control",
  "order": 8,
  "autostart": true,
  "live": true
}
